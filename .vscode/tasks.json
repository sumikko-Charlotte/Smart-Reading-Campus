{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "后端：初始化环境（建 venv + 装依赖 + 灌数据）",
      "type": "shell",
      "command": "python -m venv .venv; .venv\\Scripts\\python.exe -m pip install -r requirements.txt; .venv\\Scripts\\python.exe scripts\\seed.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "后端：启动服务 (8000)",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "后端：重新灌入演示数据",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe scripts\\seed.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "后端：运行接口冒烟测试",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe tests\\test_api_smoke.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "前端：安装依赖",
      "type": "shell",
      "command": "npm install --no-audit --no-fund",
      "options": { "cwd": "${workspaceFolder}/web-pc" },
      "problemMatcher": []
    },
    {
      "label": "前端：启动开发服务 (5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web-pc" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "前端：生产构建",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web-pc" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "★ 一键启动全栈（后端 + 前端）",
      "dependsOn": ["后端：启动服务 (8000)", "前端：启动开发服务 (5173)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
