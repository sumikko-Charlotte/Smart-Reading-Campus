# 复制为 .env 后按需修改
DEBUG=true
DATABASE_URL=sqlite:///./smart_reading.db
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/smart_reading?charset=utf8mb4

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 大模型（第 1 轮留空走 Mock，填入即切真实调用）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
PROMPT_VERSION=v1.0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
